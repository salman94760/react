import {
  FaBoxOpen,
  FaShoppingCart,
  FaRupeeSign,
  FaExclamationTriangle,
} from "react-icons/fa";
import { useEffect, useState } from "react";

/* ================= STAT CARD ================= */
const StatCard = ({ title, value, icon, color }) => (
  <div className="bg-white p-6 rounded-2xl shadow flex justify-between items-center">
    <div>
      <p className="text-gray-500 text-sm">{title}</p>
      <h2 className="text-3xl font-bold mt-2">{value}</h2>
    </div>

    <div className={`p-4 rounded-xl ${color}`}>
      {icon}
    </div>
  </div>
);

/* ================= DASHBOARD ================= */
const AdminDashboard = () => {

  const [stats, setStats] = useState(null);

  /* ===== FUTURE API FETCH ===== */
  useEffect(() => {

    // Example API Ready
    setStats({
      products: 2390,
      orders: 560,
      revenue: 125000,
      lowStock: 8,
    });

  }, []);

  if (!stats)
    return <p className="text-center mt-10">Loading Dashboard...</p>;

  return (
    <div className="p-6 bg-gray-100 min-h-screen space-y-10">

      {/* ================= STATS ================= */}
      <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-6">

        <StatCard
          title="Total Products"
          value={stats.products}
          icon={<FaBoxOpen className="text-green-600 text-2xl" />}
          color="bg-green-100"
        />

        <StatCard
          title="Total Orders"
          value={stats.orders}
          icon={<FaShoppingCart className="text-red-500 text-2xl" />}
          color="bg-red-100"
        />

        <StatCard
          title="Total Revenue"
          value={`₹${stats.revenue}`}
          icon={<FaRupeeSign className="text-blue-600 text-2xl" />}
          color="bg-blue-100"
        />

        <StatCard
          title="Low Stock"
          value={`${stats.lowStock} Items`}
          icon={
            <FaExclamationTriangle className="text-yellow-500 text-2xl" />
          }
          color="bg-yellow-100"
        />

      </div>

      {/* ================= SALES ================= */}
      <div className="grid lg:grid-cols-3 gap-6">

        <div className="lg:col-span-2 bg-white p-6 rounded-2xl shadow">
          <h2 className="font-semibold mb-4">
            Sales Overview
          </h2>

          <div className="h-52 bg-gradient-to-r from-green-100 to-green-200 rounded-xl flex items-end p-4">
            <div className="w-full h-32 bg-green-500 opacity-30 rounded"></div>
          </div>
        </div>

        {/* TOP PRODUCTS */}
        <div className="bg-white p-6 rounded-2xl shadow">
          <h2 className="font-semibold mb-4">
            Top Products
          </h2>

          {["Apple", "Milk", "Rice", "Bread"].map(
            (item, i) => (
              <div
                key={i}
                className="flex justify-between py-2 border-b"
              >
                <span>{item}</span>
                <span className="text-gray-500">
                  {400 - i * 50} units
                </span>
              </div>
            )
          )}
        </div>

      </div>

      {/* ================= RECENT ORDERS ================= */}
      <div className="bg-white p-6 rounded-2xl shadow">

        <h2 className="font-semibold mb-4">
          Recent Orders
        </h2>

        {[
          { id: "#1256", user: "Rahim", amount: "₹1200" },
          { id: "#1255", user: "Anushka", amount: "₹650" },
        ].map((o, i) => (
          <div
            key={i}
            className="flex justify-between border-b py-3"
          >
            <span>{o.id}</span>
            <span>{o.user}</span>
            <span>{o.amount}</span>
          </div>
        ))}

      </div>

    </div>
  );
};

export default AdminDashboard;